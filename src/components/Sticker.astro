---
// Hand-drawn sticker art, cut out with a white edge (see `.sticker-art` in
// global.css). The sheep, moon and sun match the ones in the app (hey-bible-app
// `app-sticker`); the meadow matches brand/art.js, with the shepherd beside the
// flock. They are decoration: screen readers skip them.
interface Props {
  name: 'sheep' | 'moon' | 'sun' | 'meadow';
  /** Width in pixels. The height follows the drawing. */
  size?: number;
  /** Degrees of tilt, as if stuck down by hand. */
  tilt?: number;
  class?: string;
}

const { name, size = 96, tilt = 0, class: className } = Astro.props;
---

<span
  class:list={['sticker-art', className]}
  style={`width: ${size}px; transform: rotate(${tilt}deg);`}
  aria-hidden="true"
  data-sticker={name}
>
  {name === 'sheep' && (
    <svg viewBox="0 0 96 78" focusable="false">
      <rect x="34" y="54" width="7" height="17" rx="3.5" fill="#5B4636" />
      <rect x="55" y="54" width="7" height="17" rx="3.5" fill="#5B4636" />
      <path d="M26 54 a12 12 0 0 1 -2 -22 a13 13 0 0 1 20 -12 a14 14 0 0 1 24 2 a12 12 0 0 1 8 22 a11 11 0 0 1 -12 12 a12 12 0 0 1 -20 2 a12 12 0 0 1 -18 -4 z" fill="#FDF8EE" stroke="#5B4636" stroke-width="2.6" stroke-linejoin="round" />
      <ellipse cx="63" cy="29" rx="5" ry="3" transform="rotate(-25 63 29)" fill="#D9A98B" stroke="#5B4636" stroke-width="2.2" />
      <ellipse cx="74" cy="39" rx="10.5" ry="11.5" fill="#EBC4A8" stroke="#5B4636" stroke-width="2.6" />
      <circle cx="73" cy="27.5" r="5.5" fill="#FDF8EE" stroke="#5B4636" stroke-width="2.2" />
      <path d="M68 38 q2.2 -2.8 4.4 0" fill="none" stroke="#5B4636" stroke-width="2" stroke-linecap="round" />
      <path d="M76 38 q2.2 -2.8 4.4 0" fill="none" stroke="#5B4636" stroke-width="2" stroke-linecap="round" />
      <circle cx="67.5" cy="43" r="2.2" fill="#E39A8A" opacity="0.8" />
      <circle cx="80.5" cy="43" r="2.2" fill="#E39A8A" opacity="0.8" />
      <path d="M72 44.5 q2 1.8 4 0" fill="none" stroke="#5B4636" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )}
  {name === 'moon' && (
    <svg viewBox="0 0 60 60" focusable="false">
      <path d="M40 6 A25 25 0 1 0 54 40 A20 20 0 0 1 40 6z" fill="#F6E3A6" stroke="#5B4636" stroke-width="2.6" stroke-linejoin="round" />
      <path d="M19 30 q2.5 -3 5 0" fill="none" stroke="#5B4636" stroke-width="2" stroke-linecap="round" />
      <path d="M29 33 q2.5 -3 5 0" fill="none" stroke="#5B4636" stroke-width="2" stroke-linecap="round" />
      <circle cx="18" cy="36" r="2.4" fill="#E39A8A" opacity="0.85" />
