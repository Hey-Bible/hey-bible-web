---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import AppStoreButtons from '../components/AppStoreButtons.astro';
import Sticker from '../components/Sticker.astro';

const carouselImages = [
  { src: '/img/carousel-3.webp', alt: 'John 13:34' },
  { src: '/img/carousel-8.webp', alt: 'Genesis 8' },
  { src: '/img/carousel-2.webp', alt: 'Luke 9:23' },
  { src: '/img/carousel-1.webp', alt: '1 Corinthians 3:8-9' },
  { src: '/img/carousel-7.webp', alt: 'Psalm 23' },
  { src: '/img/carousel-4.webp', alt: 'Acts 4:11' },
];
---

<BaseLayout title="Hey Bible - Your Complete Bible Companion">
  <div class="flex flex-col items-center justify-center pt-4 pb-4 flex-1">
    <div class="hero-heading flex items-end justify-center gap-3 px-4">
      <h1 class="text-3xl md:text-4xl">Your Complete Bible Companion</h1>
      <Sticker name="sheep" size={72} tilt={4} class="hero-sticker hidden sm:inline-block" />
    </div>

    <div class="w-full overflow-x-scroll" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">
      <div class="scroll-strip flex flex-row gap-4 px-4 items-stretch w-max">
        {carouselImages.map((img) => (
          <img
            src={img.src}
            alt={img.alt}
            class="carousel-slide rounded-2xl cursor-pointer logo-glow flex-shrink-0 h-[450px] md:h-[625px]"
            style="aspect-ratio: 4/7; object-fit: cover;"
          />
        ))}
      </div>
    </div>

    <Lightbox />
    <p class="text-lg text-center max-w-[600px] mb-4 opacity-80 px-4">
      Search the Bible, save your favorite verses, add personal notes, and
      create beautiful, shareable images of scripture.
    </p>
    <h2 class="text-2xl mb-2">Ready to get started?</h2>
    <AppStoreButtons size="large" />

    <!-- Outline "badge" mirroring the app-store badges (same 50px height) but
         clearly distinct: hollow/outlined for the developer & AI-agent path. -->
    <a
      href="/agents"
      class="mt-3 inline-flex items-center justify-start gap-2 no-underline glow-hover"
      style="height: 50px; width: 167px; padding: 0 14px 0 10px; border: 2px solid var(--color-retro-secondary); border-radius: 14px; color: var(--color-retro-text);"
      aria-label="Build with AI Agents"
    >
      <span class="text-2xl leading-none" aria-hidden="true">🤖</span>
      <span class="flex flex-col text-left leading-tight">
        <span class="text-[0.6rem] uppercase tracking-wide opacity-80">Build with</span>
        <span class="text-base font-extrabold">AI Agents →</span>
      </span>
    </a>
  </div>
</BaseLayout>
