{
  "name": "hey-bible-web",
  "compatibility_date": "2026-03-20",
  "preview_urls": true,
  // The Worker answers Range requests for the share videos, which static
  // assets alone do not (see worker/range.ts). Every other path skips it.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/video/*"]
  }
}
