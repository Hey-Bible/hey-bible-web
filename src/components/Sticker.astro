        </g>
        <path d="M28 54 C25 68 23 81 22 92 q18 3 36 0 C57 81 55 68 52 54 z" fill="none" stroke="#5B4636" stroke-width="2.6" stroke-linejoin="round" />
        <path d="M31 56 q-11 1 -18 9 l4 7 q7 -6 14 -5 z" fill="#FDF8EE" stroke="#5B4636" stroke-width="2.6" stroke-linejoin="round" />
        <circle cx="12" cy="69" r="4" fill="#E2B594" stroke="#5B4636" stroke-width="2.2" />
        <path d="M49 56 q8 5 10 19 l-7 1.5 q-1 -8 -6 -12 z" fill="#FDF8EE" stroke="#5B4636" stroke-width="2.6" stroke-linejoin="round" />
