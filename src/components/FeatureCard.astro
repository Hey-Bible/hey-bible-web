---
interface Props {
  icon: string;
  title: string;
  description: string;
  screenshot?: string;
}

const { icon, title, description, screenshot } = Astro.props;
// A card with a screenshot is as wide as the screenshot should be, so the
// picture fills it; a card with words only keeps a comfortable line length
const width = screenshot
  ? 'w-[264px] md:w-[312px] p-3 md:p-4'
  : 'min-w-[220px] max-w-[250px] md:min-w-[330px] md:max-w-[375px] p-3 md:p-5';
---

<div
  class:list={['feature-card sticker-card transition-all duration-300 hover:-translate-y-1 flex-shrink-0 cursor-pointer flex flex-col', width]}
  data-title={`${icon} ${title}`}
  data-description={description}
  data-screenshot={screenshot || ''}
>
  <h3 class="text-lg mb-1" style={`color: var(--color-retro-text);`}>{icon} {title}</h3>
  <p class="text-sm leading-relaxed opacity-80 min-h-[2.5em]" style={`color: var(--color-retro-text);`}>{description}</p>
  {screenshot && (
    <div class="flex-grow flex items-end mt-2">
      <img
        src={screenshot}
        alt={`${title} screenshot`}
        class="rounded-xl w-full h-auto logo-glow"
        width="990"
        height="2151"
        style="box-shadow: var(--sticker-shadow-sm);"
      />
    </div>
  )}
</div>
